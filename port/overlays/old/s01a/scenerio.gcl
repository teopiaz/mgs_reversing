                    -a 320
                    -t 90
                    -m true
                    -e sub_1055
            } elseif (arg1 == b:1) {
                chara $s:51c6 $s:9fe8 \
                    -c -11986 3677 -12693 -5805 -1184 -10543
                    -a 320
                    -t 90
                    -m true
                    -e sub_1055
            } elseif (arg1 == b:2) {
                chara $s:51c6 $s:9fe8 \
                    -c 9417 6579 -11191 5560 -396 -10559
                    -a 320
                    -t 90
                    -m true
                    -e sub_1055
            } elseif (arg1 == b:3) {
                chara $s:51c6 $s:9fe8 \
                    -c 9445 5427 -11868 6126 -219 -7278
                    -a 320
                    -t 90
                    -m true
                    -e sub_1055
            } elseif (arg1 == b:4) {
                chara $s:51c6 $s:9fe8 \
                    -c 8458 6447 -10168 6709 -858 -12911
                    -a 320
                    -t 90
                    -m true
                    -e sub_1055
            } elseif (arg1 == b:5) {
                chara $s:51c6 $s:9fe8 \
                    -c 7008 5001 -12637 10108 2363 -7200
                    -a 320
                    -t 90
                    -m true
                    -e sub_1055
            }
        }
    }
}

# sub_0AF7 — Meryl-info gate. Fires after a `radio -p sub_0AF7` callback;
# clamps story progress past 52..58 if the player has already heard Meryl's
# disclosure (contact 14015). Prevents replaying the intro twice.
proc sub_0AF7 {
    if (arg2 == 14015 && b:52 <= $w:00000A && $w:00000A < b:58) {
        eval($w:00000A = b:58)
    }
}


# ============================================================================
# 13. MAIN SCRIPT
# ============================================================================
#
# Runs in this rough sequence:
#   A. Re-arm low-HP / camera-mode pollers if mid-game.
#   B. Initialise difficulty-tuned alert params and lighting.
#   C. mapdef + sound init + system callbacks.
#   D. STORY-PROGRESS BRANCH on $w:00000A — picks intro stage (cutscenes)
#      or normal HUD setup.
#   E. Register all the traps / ntraps for zones, doors, item areas,
#      camera-angle changes.
#   F. Spawn ambient charas (snow, smoke, sphere skybox, walls, rumble).
#   G. Item spawns (gated by sub_3353 cooldowns).
#   H. Codec memo / save-reminder evaluation.
#   I. Final "place Snake + footprint chara + initial camera" handoff.

script {
    # -- A. Pollers --
    # If we're in normal gameplay (00000A < 237) and the HP-poll is enabled
    # ($f:01004E), kick off the recursive low-HP nag.
    if ($w:00000A < b:237 && $f:01004E && ($w:80006E > b:0 || $f:0703E5 && $w:0003EA <= b:60)) {
        call(sub_CCE3)
    }
    # In the late-game window 238..248 (specific story beats), also tick the
    # camera-mode tracker so radar transitions get tagged correctly.
    if (b:238 <= $w:00000A && $w:00000A < b:249) {
        call(sub_1C8A)
    }
    call(sub_860B)                  # scrub stale codec memos
    eval($b:0000AA = b:2)           # set radar mode (?)

    # -- B. Difficulty-tuned guard alert params --
    # $w:000412..418 are sight/hearing radii consumed by sub_1907/1909.
    if ($w:800002 <= b:0) {
        eval($w:000412 = 4000)
        eval($w:000414 = 5000)
        eval($w:000416 = 4000)
        eval($w:000418 = 8000)
    } elseif ($w:800002 == b:1) {
        eval($w:000412 = 5000)
        eval($w:000414 = 6000)
        eval($w:000416 = 5000)
        eval($w:000418 = 8000)
    } elseif ($w:800002 == b:2) {
        eval($w:000412 = 6000)
        eval($w:000414 = 7000)
        eval($w:000416 = 6000)
        eval($w:000418 = 8000)
    } else {
        eval($w:000412 = 8000)
        eval($w:000414 = 8000)
        eval($w:000416 = 8000)
        eval($w:000418 = 8000)
    }
    # Lights — black during specific cutscene phase, normal otherwise.
    if ($f:05006E == b:1 && $b:000074 == b:2) {
        call(sub_78DB)
    } else {
        call(sub_200D)
    }

    # -- C. Map and sound --
    mapdef $s:7df9 \
        -k $s:c681
        -l $s:c681
        -h $s:c681 0
        -z 0
    sound \
        -k b:154 b:0 b:156
        -r b:39 b:0 b:39
    # Title strap: "HELIPORT" if we got here from VR mode (first-clear special),
    # otherwise lower-case "Heliport". $f:000387 is the first-clear flag.
    if ($f:000387) {
        system \
            -a sub_8892
            -g sub_9C2B
            -s "- HELIPORT -"
    } else {
        system \
            -a sub_8892
            -g sub_9C2B
            -w sub_2BAB                   # wall-spawner callback
            -s "- Heliport -"
    }
    # Reset per-camera "saw Snake" flags so they only count the current visit.
    eval($f:050387 = b:0)
    eval($f:060387 = b:0)
    eval($f:070387 = b:0)
    eval($f:040435 = b:0)
    map \
        -a $s:7df9

    # -- D. Story-progress branch --
    # The block runs different cutscene sequences based on $w:00000A.
    if ($f:05006E == b:1) {
        # Mid-cutscene re-entry — drive the next step of the conversation.
        mesg $s:24de $s:d5cc
        if ($b:000074 == b:0) {
            # Step 1: meet Demodoll (Liquid silhouette).
            sound \
                -b b:1 b:2
                -n
            eval($b:000074 = b:1)
            chara $s:7a05 $s:6eca \
                -t 30000
                -e 1
            menu \
                -r 0
                -m 0
                -l 0
            pad \
                -r
            call(sub_C521)
        } elseif ($b:000074 == b:1) {
            # Step 2: explosion + rumble.
            sound \
                -b b:1 b:2
                -n
            eval($b:000074 = b:2)
            chara $s:7a05 $s:6eca \
                -t 30000
                -e 1
            menu \
                -r 0
                -m 0
                -l 0
            pad \
                -r
            call(sub_CED0)
        } elseif ($b:000074 == b:2) {
            # Step 3: branch decision (proceed to s06a or s12c).
            eval($b:000074 = b:3)
            chara $s:7a05 $s:6eca \
                -t 30000
                -e 1
            menu \
                -r 0
                -m 0
                -l 0
            pad \
                -r
            mesg $s:18e3 $s:c927
            call(sub_4751)
        } elseif ($b:000074 == b:3) {
            # Step 4: final wind-down, big rumble, voice line, return to gameplay.
            sound \
                -x sd:FF0000FE
            chara $s:a12e $s:62fe \
                -m 1
                -s 30
            chara $s:7a05 $s:6eca \
                -t 30000
                -e 1
            eval($b:000074 = b:4)
            menu \
                -r 0
                -m 0
                -l 0
            pad \
                -r
            camera \
                -s b:4 b:1 b:0 b:0 -3500 2565 -5503 -1433 1094 -6666
            mesg $s:c356 4 $s:0dd2
            camera \
                -s b:4 b:1 b:2 b:0 -3500 2565 -5503 -1433 1094 -6666
            delay \
                -t 60
                -e {
                # Rumble pulse 1.
                chara $s:fed1 $s:922b b:127 b:2 b:0 b:8 b:127 b:2
                chara $s:fed1 $s:a83b b:65 b:18 b:45 b:12 b:35 b:10 b:105 b:2
            }
            delay \
                -t 70
                -e {
                # Camera shake (CAMERA_SHAKE = $s:7bc2).
                chara $s:7bc2 $s:ef22 \
                    -p -3500 2565 -5503
                    -r 5000
                    -s 512
                    -l 15
            }
            sound \
                -v t:00002AB2
                -f sub_816B          # callback when the voice finishes
        }
    } elseif ($w:00000A < b:9) {
        # First entry — force the d01a intro cutscene to play.
        eval($w:00000A = b:9)
        call(sub_9FBB)
    } elseif ($w:00000A < b:12) {
        # After d01a — Campbell's first call.
        sound \
            -b b:1 b:2
            -n
        eval($w:00000A = b:12)
        radio \
            -c 14085 t:0201013D b:4
            -p sub_AD2D
    } elseif ($w:00000A < b:13) {
        eval($w:00000A = b:13)
        call(sub_9FBB)
    } elseif ($w:00000A < b:16 && $w:000076 == b:0) {
        # After 2nd cutscene — Campbell's second call.
        sound \
            -b b:1 b:2
            -n
        eval($w:000076 = b:1)
        radio \
            -c 14085 t:02020140 b:4
            -p sub_AD2D
    } elseif ($w:00000A < b:16 && $w:000076 == b:1) {
        # The "Snake walks past the cargo elevator" beat — loops camera high
        # over the room, plays a long voice line, then auto-restarts.
        # On Hard+, skip the intro voice line and just jump straight in.
        sound \
            -b b:1 b:2
            -n
        camera \
            -s b:5 b:1 b:1 b:0 -4714 8805 25439 -4647 1417 19651
        mesg $s:c356 5 $s:0dd2
        call(sub_1908)
        eval($w:000076 = b:2)
        eval($w:000070 = $w:80001E)
        eval($w:000072 = $w:80001C)
        eval($w:80001E = -(b:1))
        eval($w:80001C = -(b:1))
        chara $s:7a05 $s:6eca \
            -t 30000
            -e 1
        pad \
            -r
        if ($w:800002 < b:2) {
            sound \
                -v t:00002305
                -f sub_C2FE
            chara $s:b4e6 $s:923d \
                -p sub_C2FE
                -s 16
                -m 64
        } else {
            delay \
                -t 2
                -e {
                restart
            }
        }
    } elseif ($w:00000A < b:16 && $w:000076 == b:2) {
        # After the long voice line — Campbell's third call.
        sound \
            -b b:1 b:2
            -n
        eval($w:00000A = b:16)
        radio \
            -c 14085 t:03020144 b:4
            -p sub_AD2D
    } elseif ($w:00000A < b:18) {
        # Story progress 16..17: full HUD spawn + final intro voice line.
        sound \
            -b b:1 b:2
            -n
        if ($w:80006C >= b:1) {
            call(sub_1909)
        } else {
            call(sub_1907)
        }
        eval($w:00000A = b:18)
        varsave $w:00000A
        eval($w:80001E = -(b:1))
        eval($w:000072 = $w:80001C)
        eval($w:80001C = -(b:1))
        pad \
            -r
        if ($f:030435 == b:1) {
            camera \
                -e
                -b -1300 -30000 -30000 1300 4000 30000
                -l -30000 -30000 -30000 30000 4000 30000
                -s b:5 b:0 b:1 b:0 0 0 0 360 0 9500 2
            mesg $s:c356 5 $s:0dd2
        }
        chara $s:7a05 $s:6eca \
            -t 30000
            -e 0
        sound \
            -v t:000028CC
        chara $s:3ed7 $s:6a9f \
            -d $s:3ff5
            -r 0
            -c
            -f sub_EAB1                  # post-intro callback
    } else {
        # Normal gameplay (≥ 18): spawn HUD + restore alert positions.
        sound \
            -b b:1 b:2
            -n
        if ($w:80006C >= b:1) {
            call(sub_1909)
        } else {
            call(sub_1907)
        }
        chara $s:a12e $s:62fe \
            -m 1
            -s 45
        if ($f:030435 == b:1) {
            # Extras mode — hide the kage actors (parked off-stage)
            # except when arriving from cell-block stages s02a/s02b.
            if ($s:800094 != $s:46db && $s:800094 != $s:46dc) {
                mesg $s:1465 $s:430f 21 -9000 0 3000
                mesg $s:1466 $s:430f 22 0 30000 0
            }
            mesg $s:1467 $s:430f 23 -1500 6000 -17000
        }
    }

    # -- E. Camera/zone bindings --
    # Two ntraps for zone 0x6373 (alert volume): one re-positions the
    # cinema camera on enter/leave, the other toggles snow + door state.
    ntrap $s:6373 &SNAKE \
        -m $s:14c9
        -c
        -e {
        if (arg3 == $s:0dd2) {
            call(sub_A107)
        } else {
            call(sub_3DE5)
        }
    }
    ntrap $s:6373 &SNAKE \
        -m $s:14c9
        -c
        -e {
        if (arg3 == $s:0dd2) {
            mesg $s:18e3 $s:c927
            eval($f:07023D = b:0)
            sound \
                -x sd:FF000007
            mesg $s:ca70 $s:d5cc
            mesg $s:dd6d $s:2761
        } else {
            mesg $s:18e3 $s:0e4e
            eval($f:07023D = b:1)
            sound \
                -x sd:FF000008
            mesg $s:ca70 $s:0dd2
            mesg $s:dd6d $s:ed7f
        }
    }
    # Same zone, different subject (RCM = $s:50ae) — non-Snake actor handler.
    trap $s:6373 $s:50ae $s:14c9 {
        if (arg3 == $s:0dd2) {
            mesg $s:18e3 $s:c927
            eval($f:07023D = b:0)
            sound \
                -x sd:FF000007
            mesg $s:ca70 $s:d5cc
            mesg $s:dd6d $s:2761
        } else {
            if ($f:0303D6 == b:1) {
                mesg $s:18e3 $s:c927
                eval($f:07023D = b:0)
                sound \
                    -x sd:FF000007
                mesg $s:ca70 $s:d5cc
                mesg $s:dd6d $s:2761
            } else {
                mesg $s:18e3 $s:0e4e
                eval($f:07023D = b:1)
                sound \
                    -x sd:FF000008
                mesg $s:ca70 $s:0dd2
                mesg $s:dd6d $s:ed7f
            }
        }
    }

    # -- Patrol-route alarm (zone 0x6373 + Snake + entry) --
    # If Snake enters this zone for the first time, summon an alarm zone.
    trap $s:6373 &SNAKE $s:0dd2 {
        if ($f:06006E != b:1) {
            eval($f:06006E = b:1)
            if ($b:00006F == b:0) {
                eval($f:04006E = b:1)
                sound \
                    -v t:00017213
                chara $s:7a05 $s:6eca \
                    -t 30000
                    -e 0
                chara $s:51c6 $s:9fe8 \
                    -c -17434 3054 4125 -12676 707 6448
                    -a 480
                    -t 90
                    -m true
                    -e sub_1055
            }
        }
    }

    # Two zones (0xa57a/b) toggle snow on opposite events — used to mask /
    # reveal snow in specific corridors.
    ntrap $s:a57a &SNAKE \
        -s 9
        -m $s:14c9
        -d 3072 640
        -e {
        if (arg3 == $s:0dd2) {
            mesg $s:18e3 $s:c927
        } else {
            mesg $s:18e3 $s:0e4e
        }
    }
    ntrap $s:a57b &SNAKE \
        -s 9
        -m $s:14c9
        -d 1024 640
        -e {
        if (arg3 == $s:0dd2) {
            mesg $s:18e3 $s:0e4e
        } else {
            mesg $s:18e3 $s:c927
        }
    }

    # -- F. Pre-intro alarm trigger zones --
    # Six zones (0xc776..c77b) each map to one of the 6 spotting positions
    # in sub_3D10. Only registered before story progress 19 (= during intro).
    if ($w:00000A < b:19) {
        trap $s:c776 &SNAKE $s:0dd2 {
            call(sub_3D10, 0)
        }

        trap $s:c777 &SNAKE $s:0dd2 {
            call(sub_3D10, 1)
        }

        trap $s:c778 &SNAKE $s:0dd2 {
            call(sub_3D10, 2)
        }

        trap $s:c779 &SNAKE $s:0dd2 {
            call(sub_3D10, 3)
        }

        trap $s:c77a &SNAKE $s:0dd2 {
            call(sub_3D10, 4)
        }

        trap $s:c77b &SNAKE $s:0dd2 {
            call(sub_3D10, 5)
        }

    }

    # -- Door zones (75c5/75c6) — north and east doors --
    # Each zone enter triggers the cutscene sequence to load s02b/s02d
    # (north) or s02a/s02c/s02e (east), plus a fade and brief Snake animation.
    trap $s:75c5 &SNAKE $s:0dd2 {
        mesg $s:b455 $s:006b 4096
        mesg &SNAKE $s:937a 2 2048 2048 2 305     # play door-open motion
        menu \
            -r 0
            -m 0
            -l 0
        chara $s:51c6 $s:9fe8 \
            -c -1134 6132 -21815 -1469 6186 -20672
            -a 320
            -t 180
        if ($f:000387 != b:1) {
            delay \
                -t 30
                -e {
                sound \
                    -x sd:01FFFF0B
                chara $s:a12e $s:62fe \
                    -m 0
                    -s 22
            }
            eval($f:06006E = b:1)
            # First/later visit branch chooses the right destination.
            if ($w:00000A < b:51) {
                delay \
                    -t 53
                    -p sub_41BC
            } else {
                delay \
                    -t 53
                    -p sub_49BC
            }
        } else {
            # First-clear/VR path: skip transition, play menu animation.
            delay \
                -t 30
                -e {
                eval($b:000049 = b:2)
                chara $s:aefb $s:923d \
                    -v t:00016CCB
            }
        }
    }

    trap $s:75c6 &SNAKE $s:0dd2 {
        mesg $s:b455 $s:006b 4096
        mesg &SNAKE $s:937a 2 2048 2048 2 305
        menu \
            -r 0
            -m 0
            -l 0
        chara $s:51c6 $s:9fe8 \
            -c -9827 249 -16751 -9765 267 -15560
            -a 320
            -t 180
        if ($f:000387 != b:1) {
            delay \
                -t 30
                -e {
                sound \
                    -x sd:01FFFF0B
                chara $s:a12e $s:62fe \
                    -m 0
                    -s 22
            }
            eval($f:06006E = b:1)
            if ($w:00000A < b:51) {
                delay \
                    -t 53
                    -p sub_3DBC
            } elseif ($w:80006C < b:4) {
                delay \
                    -t 53
                    -p sub_45BC
            } else {
                delay \
                    -t 53
                    -p sub_B7E2
            }
        } else {
            delay \
                -t 30
                -e {
                eval($b:000049 = b:2)
                chara $s:aefb $s:923d \
                    -v t:00016CCB
            }
        }
    }

    # -- Alert zone 0x23fb (sniped/spotted view) --
    # Enter handler: trigger alert camera (sub_81E5) + reposition guard.
    # Leave handler: restore default camera (sub_3DE5).
    ntrap $s:23fb &SNAKE \
        -m $s:0dd2
        -c
        -e {
        call(sub_81E5)
        if (arg7 != b:2) {
            if ($f:030435 == b:1) {
                mesg $s:1467 $s:430f 23 -1500 6000 -16750
            } else {
                mesg $s:1467 $s:430f 18 -1500 6000 -16750
            }
        }
    }
    trap $s:98fd &SNAKE $s:0dd2 {
        if ($f:030435 == b:1) {
            mesg $s:1467 $s:430f 23 -1500 6000 -16750
        } else {
            mesg $s:1467 $s:430f 18 8500 6000 -13750
        }
    }

    ntrap $s:23fb &SNAKE \
        -m $s:d5cc
        -c
        -e {
        call(sub_3DE5)
        sound \
            -x sd:FF000008
        mesg $s:18e3 $s:0e4e
        mesg $s:ca70 $s:0dd2
        if (arg7 != b:2) {
            if ($f:030435 == b:1) {
                mesg $s:1467 $s:430f 23 -1500 6000 -16750
            } else {
                mesg $s:1467 $s:430f 18 9750 1500 -11500
            }
        }
    }

    # -- Per-zone camera angle bindings --
    # Each ntrap binds a fixed camera angle proc to a zone. The mesg call
    # at the end pushes the trigger event back to CHARAID c356 (the camera
    # commander) so it can interleave animations.
    ntrap $s:dad1 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_61C4)
        mesg $s:c356 1 arg3
    }
    ntrap $s:2ad2 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_62E4)
        mesg $s:c356 1 arg3
    }
    ntrap $s:2ad3 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_62E5)
        mesg $s:c356 1 arg3
    }
    ntrap $s:2ad4 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_62E6)
        mesg $s:c356 1 arg3
    }
    ntrap $s:22d2 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_6404)
        mesg $s:c356 1 arg3
    }
    ntrap $s:22d3 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_6405)
        mesg $s:c356 1 arg3
    }
    ntrap $s:e2d1 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_6204)
        mesg $s:c356 1 arg3
    }
    ntrap $s:5970 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_63E4)
        mesg $s:c356 2 arg3
    }
    ntrap $s:2cd1 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_63D7)
        mesg $s:c356 1 arg3
    }
    ntrap $s:0e62 &SNAKE \
        -m $s:14c9
        -s 5
        -e {
        call(sub_6224)
        mesg $s:c356 1 arg3
    }
    ntrap $s:0e63 &SNAKE \
        -m $s:14c9
        -s 5
        -e {
        call(sub_6225)
        mesg $s:c356 1 arg3
    }
    ntrap $s:4bec &SNAKE \
        -m $s:14c9
        -s 5
        -e {
        call(sub_63BF)
        mesg $s:c356 1 arg3
    }
    ntrap $s:b398 &SNAKE \
        -m $s:14c9
        -c
        -e {
        call(sub_6840)
        mesg $s:c356 1 arg3
    }

    # -- Stairwell footstep zones (0x4a9c/4a9d) --
    # On enter, animate Snake taking a stair-step + rumble + sound, scaled
    # by Snake's height ($b:000078 = (Y + 2500) / 48).
    ntrap $s:4a9c &SNAKE \
        -m $s:0dd2
        -s 0
        -d 2048 1023
        -e {
        mesg &SNAKE $s:937a 0 2048 -1 0 0
        eval($b:000078 = (arg4 + 2500) / b:48)
        chara $s:fed1 $s:922b b:0 b:13 b:127 b:1
        chara $s:fed1 $s:a83b b:160 b:2 b:0 b:11 b:120 b:3
        delay \
            -t 19
            -e {
            sound \
                -e $b:000078 b:63 b:28
        }
    }
    ntrap $s:4a9d &SNAKE \
        -m $s:0dd2
        -s 0
        -d 0 1023
        -e {
        mesg &SNAKE $s:937a 1 0 -1 0 0
        eval($b:000078 = (arg4 + 2500) / b:48)
        chara $s:fed1 $s:922b b:0 b:13 b:127 b:2
        chara $s:fed1 $s:a83b b:120 b:2 b:0 b:11 b:160 b:3
        delay \
            -t 18
            -e {
            sound \
                -e $b:000078 b:63 b:28
        }
    }

    # Continue prompt: the COUNTDOWN chara ($s:24de) listens to zone b656
    # while we're in normal mode (not bandana / not VR).
    if ($f:0002CC != b:1 && $f:000387 != b:1) {
        trap $s:b656 &SNAKE $s:14c9 {
            if ($f:05006E != b:1) {
                mesg $s:24de arg3
            }
        }

    }
    # Two more zone bindings for the cargo-elevator close-up cameras.
    ntrap $s:1ed3 &SNAKE \
        -m $s:14c9
        -s 8
        -e {
        call(sub_63E5)
        mesg $s:c356 1 arg3
    }
    ntrap $s:5970 &SNAKE \
        -m $s:14c9
        -s 8
        -e {
        call(sub_63E5)
        mesg $s:c356 1 arg3
    }
    # Snow toggle zone 0x2573 — opposite logic vs the main snow gates.
    trap $s:2573 &SNAKE $s:14c9 {
        if (arg3 == $s:0dd2) {
            mesg $s:18e3 $s:c927
            mesg $s:b455 $s:d182 4096
        } else {
            mesg $s:18e3 $s:0e4e
            mesg $s:b455 $s:006b 4096
        }
    }

    # -- F2. Ambient charas --
    chara $s:18e3 $s:4692 \                          # SNOW emitter, room-wide
        -l -5000 0 -5000
        -h 5000 5000 5000
        -s 50 -20 0
        -w 50 -20 -50
        -n 256
    chara $s:170c $s:bb75 -6000 700 1468             # smoke wisp 1
    chara $s:170c $s:bb75 2476 700 14603             # smoke wisp 2
    chara $s:170c $s:bb75 3563 700 -433              # smoke wisp 3
    chara $s:73ea $s:f810 \                          # SPHERE skybox (CHARAID_SPHERE)
        -m $s:c681
        -y -50
        -s 4
        -c 30 35 56
    chara $s:ec77 $s:ca70 \                          # WALL collision
        -p 0 0 0
        -d 0 0 0
        -m $s:6d53
    chara $s:5a50 $s:b455 \                          # GAS_EFFECT (atmospheric)
        -c 0 0 0 64 64 64
        -w 0
        -b 2
        -r 32
    chara $s:02c4 $s:ab10                            # ASIATOKUN — footprint trail

    # -- Trapdoor / fall zones --
    # 5 traps that call func -p (engine trigger) when Snake enters them at
    # the wrong height; used for "fell off the edge" detection.
    trap $s:c3df &SNAKE $s:14c9 {
        func \
            -p b:16 -2831 2139 32767 arg3
    }

    trap $s:c3e0 &SNAKE $s:14c9 {
        func \
            -p b:16 4140 3160 32767 arg3
    }

    trap $s:c3e1 &SNAKE $s:14c9 {
        func \
            -p b:30 -1288 30000 -21061 arg3
    }

    trap $s:c3e2 &SNAKE $s:14c9 {
        func \
            -p b:39 -9500 2000 -12125 arg3
    }

    trap $s:c3e3 &SNAKE $s:14c9 {
        func \
            -p b:40 8500 1500 -12000 arg3
    }

    chara $s:3f9a $s:9477 \                          # ENV_SOUND (wind / ambience)
        -p -1000 -10000 30000
        -t 0
        -r 10000
        -n 176
        -i 210
        -c -1
        -s true

    # -- G. Item spawns (gated by sub_3353 cooldown checker) --
    if ($f:000387 != b:1) {
        # Each call(sub_3353, $b:00007X) sets $f:040001 = should-spawn?
        call(sub_3353, $b:000079)
        if ($f:040001) {
            chara $s:8767 $s:eeba \                  # RATION pickup A
                -p 13770 1500 0
                -h 500
                -b b:4
                -i b:13
                -n 1
                -m "RATION"
                -x {
                eval($b:000079 = $b:000000)
            }
        }
        call(sub_3353, $b:00007A)
        if ($f:040001) {
            chara $s:8767 $s:eebb \                  # RATION pickup B
                -p -12250 0 23250
                -h 500
                -b b:4
                -i b:13
                -n 1
                -m "RATION"
                -x {
                eval($b:00007A = $b:000000)
            }
        }
        call(sub_3353, $b:00007B)
        if ($f:040001) {
            chara $s:8767 $s:eebc \                  # CHAFF GRENADE x3
                -p 0 1000 7000
                -h 500
                -b b:0
                -i b:8
                -n 3
                -m "CHAFF GRENADE * 3"
                -x {
                eval($b:00007B = $b:000000)
            }
        }
        call(sub_3353, $b:00007C)
        if ($f:040001) {
            chara $s:8767 $s:eebd \                  # STUN GRENADE x3
                -p -19000 0 7500
                -h 500
                -b b:0
                -i b:7
                -n 3
                -m "STUN GRENADE * 3"
                -x {
                eval($b:00007C = $b:000000)
            }
        }
        if ($w:800022 < b:0) {
            # Player doesn't have SOCOM yet → spawn the unique pickup.
            if ($f:03005D != b:1) {
                chara $s:8767 $s:eebe \              # SOCOM (unique)
                    -p -2700 1000 -8000
                    -h 500
                    -b b:0
                    -i b:0
                    -n 12
                    -m "SOCOM"
            }
        } else {
            # Has SOCOM → respawn ammo at two locations.
            call(sub_3353, $b:00007E)
            if ($f:040001) {
                chara $s:8767 $s:eec0 \              # SOCOM ammo A
                    -p -11548 6000 -14548
                    -h 500
                    -b b:2
                    -i b:0
                    -n 12
                    -m "SOCOM/BULLET * 12"
                    -x {
                    eval($b:00007E = $b:000000)
                }
            }
            call(sub_3353, $b:00007F)
            if ($f:040001) {
                chara $s:8767 $s:eec1 \              # SOCOM ammo B
                    -p -19540 0 9393
                    -h 500
                    -b b:2
                    -i b:0
                    -n 12
                    -m "SOCOM/BULLET * 12"
                    -x {
                    eval($b:00007F = $b:000000)
                }
            }
            # Bandana (cleared-game) bonus: NIKITA spawn point.
            if ($f:0002CC == b:1) {
                if ($w:800028 < b:0) {
                    chara $s:8767 $s:8aad \          # NIKITA LAUNCHER (bandana only)
                        -p -2700 1000 -8000
                        -h 500
                        -b b:0
                        -i b:3
                        -n 4
                        -m "NIKITA LAUNCHER"
                }
            }
        }
        # Coming back from cell-block? Bandana grants a one-time C4 cache.
        if ($f:0002CC == b:1) {
            if ($s:800094 == $s:46db || $s:800094 == $s:46dc) {
                if ($f:0102CC != b:1) {
                    chara $s:8767 $s:8aab \          # C4 x2 (one-time)
                        -p -19000 0 8250
                        -h 500
                        -b b:0
                        -i b:6
                        -n 2
                        -m "C4 * 2"
                        -x {
                        eval($f:0102CC = b:1)
                    }
                }
            }
        }
    } else {
        # First-clear/VR mode: a pre-set inventory laid out for the player.
        chara $s:8767 $s:eeba \                       # THERMAL GOGGLE
            -p -14000 0 12000
            -h 500
            -b b:1
            -i b:6
            -n 1
            -m "THERMAL GOGGLE"
        chara $s:8767 $s:eeba \
            -p 13770 1500 0
            -h 500
            -b b:4
            -i b:13
            -n 1
            -m "RATION"
        chara $s:8767 $s:eeba \
            -p -12250 0 23250
            -h 500
            -b b:4
            -i b:13
            -n 1
            -m "RATION"
        chara $s:8767 $s:eeba \
            -p 0 1000 7000
            -h 500
            -b b:0
            -i b:8
            -n 3
            -m "CHAFF GRENADE * 3"
        chara $s:8767 $s:eeba \
            -p -19415 0 8269
            -h 500
            -b b:0
            -i b:7
            -n 3
            -m "STUN GRENADE * 3"
        chara $s:8767 $s:eeba \
            -p -2700 1000 -8000
            -h 500
            -b b:0
            -i b:0
            -n 12
            -m "SOCOM"
        chara $s:8767 $s:eeba \
            -p 12500 6000 -14500
            -h 500
            -b b:1
            -i b:2
            -n 1
            -m "CARDBOARD BOX/A"
    }
    # Spawn the continue-countdown timer (only in normal mode).
    if ($f:0002CC != b:1 && $f:000387 != b:1) {
        chara $s:cb3a $s:24de \                       # TRUCKTRAP / continue prompt
            -t 150
            -e sub_2631 sub_A87E sub_AC00
    }
    # Footprint trail emitter — leaves prints when Snake walks on snow.
    chara $s:92bc $s:7b22 \
        -t $s:98fd $s:7396 $s:dc55 $s:6373
        -s 171 170 173 172 175 174 173 172
        -f 168 169 170 171 172 173 0 0
        -n 0 0 0 0
        -i 5 6 5 6 177 178 5 6

    # -- H. Codec memo / save reminders --
    radio \
        -b 14007 t:2626087F                    # always-pending Master memo
    call(sub_860B)                             # scrub stale memos
    call(sub_5A77)                             # Campbell save reminder
    if ($f:000387) {
        radio \
            -b 14180 t:060402E9                # Master in VR
    } else {
        if ($w:00000E > b:0) {
            if ($w:00000A < b:174 || b:195 <= $w:00000A) {
                radio \
                    -b 14180 t:060402E9
            }
        }
    }
    call(sub_E42A)                             # Nastasha
    if (b:107 <= $w:00000A) {
        radio \
            -b 14112 t:1B1801DD                # Otacon (post-meeting)
    }
    call(sub_DB13)                             # Mei Ling
    if (b:52 <= $w:00000A && $w:00000A < b:107) {
        radio \
            -b 14015 t:0A080015                # Meryl intro window
            -p sub_0AF7
    }

    # -- Codec hint zones (story-progress-gated) --
    # Each `radio -o arg3 ...` triggers a one-shot hint on enter only.
    trap $s:9b5c &SNAKE $s:14c9 {
        radio \
            -o arg3 14085 t:01010404
    }

    trap $s:da12 &SNAKE $s:14c9 {
        radio \
            -o arg3 14085 t:01010402
    }

    trap $s:d662 &SNAKE $s:14c9 {
        radio \
            -o arg3 14085 t:03020406
    }

    if ($w:00000A < b:26) {
        trap $s:caf8 &SNAKE $s:0dd2 {
            if (!($f:07006E) && $b:00006F == b:0) {
                radio \
                    -c 14085 t:0101040B b:0
            }
            radio \
                -o arg3 14085 t:0101040B
        }

        trap $s:caf8 &SNAKE $s:d5cc {
            radio \
                -o arg3 14085 t:0101040B
            radio \
                -r
        }

    }
    trap $s:73d2 &SNAKE $s:14c9 {
        if ($w:00000A < b:24) {
            radio \
                -o arg3 14085 t:02010563
            radio \
                -o arg3 14096 t:0C0D0040
        }
    }

    if ($f:000387) {
        trap $s:dc55 &SNAKE $s:14c9 {
            if ($w:00000A < b:174 || b:195 <= $w:00000A) {
                radio \
                    -o arg3 14180 t:02010335
            }
        }

    } else {
        if ($w:00000E > b:0) {
            trap $s:dc55 &SNAKE $s:14c9 {
                if ($w:00000A < b:174 || b:195 <= $w:00000A) {
                    radio \
                        -o arg3 14180 t:02010335
                }
            }

        }
    }
    trap $s:b476 &SNAKE $s:14c9 {
        radio \
            -o arg3 14085 t:0101040D
    }

    if ($w:00000A < b:69) {
        # Early-game Nastasha + Campbell hint pair.
        trap $s:5267 &SNAKE $s:14c9 {
            radio \
                -o arg3 14085 t:110F040F
            radio \
                -o arg3 14152 t:0F0B070D
        }

        trap $s:5268 &SNAKE $s:14c9 {
            radio \
                -o arg3 14085 t:110F042F
            radio \
                -o arg3 14152 t:0F0B0727
        }

    }
    if ($w:80006C < b:1) {
        trap $s:5269 &SNAKE $s:14c9 {
            radio \
                -o arg3 14085 t:110F044F
            radio \
                -o arg3 14152 t:0F0B0741
        }

    }

    # -- I. Final Snake placement and camera handoff --
    map \
        -a $s:80000E
    map \
        -c $s:80000E
        -u
    eval($w:800020 = $w:000004)            # save initial face dir
    chara &SNAKE &SNAKE \                # SPAWN SNAKE
        -p $w:800010 $w:800012 $w:800014    #   pre-set position
        -d 0 $w:000002 0                    #   pre-set face yaw
        -o $s:e91e                          #   override identity (?)
    chara $s:4170 $s:6f8b \                # CHARAID_BREATH (cold breath)
        -t 90
    mesg &SNAKE $s:f9ad $s:80000E         # tell Snake which map he's in
    call(sub_3DE5)                          # default camera + snow on
    sound \
        -x sd:FF000008                     # final ambience tick
    mesg $s:18e3 $s:0e4e
    mesg $s:ca70 $s:0dd2
    chara $s:0fad $s:0afd \                # CHARAID_MOTIONSE (motion-sound coupler)
        -m 2
        -n 4
        -s 0 178 13 177 27 178 42 177
}


