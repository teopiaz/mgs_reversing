# GCL decompiler output (port/gcl_tools)
# 75 top-level block(s)
#
# ============================================================================
# s01a — TANK HANGAR (scenerio.gcx)
# ============================================================================
#
# This is the heart of the introductory area: where Snake first walks around
# after the cargo elevator opens. The script is unusually large (75 top-level
# blocks) because the same .gcx is re-entered MULTIPLE times during the intro
# cutscene chain, and it gates behaviour on `$w:00000A` (story progress).
#
# Major subsystems (search this file for the section headers below):
#
#   1.  STAGE TRANSITIONS        sub_9FBB  → loads of d01a / s02a..e / s06a / s12c
#   2.  STAGE COUNTER            sub_8CD4  ($b:000000 stage-visit counter)
#   3.  ITEM-RESPAWN GATING      sub_3353  decides if a pickup respawns
#   4.  LIGHTING                 sub_200D / sub_78DB
#   5.  CODEC LOW-HP NAGS        sub_CCE3  recursive radio nag based on $w:80006E
#   6.  SAVE-MEMO MANAGEMENT     sub_E42A / sub_860B / sub_8132 / sub_5A77 / sub_DB13
#   7.  SAVE JINGLE PICKER       sub_49C9  picks "save complete" SFX from $w:0002CA
#   8.  HUD / CAMERA COMMANDER   sub_1907 / sub_1908 / sub_1909  build the HUD overlay
#   9.  GUARDS / SEARCHLIGHTS    sub_7ECB..D, sub_A22F / sub_A230, sub_8B69..C
#  10.  CAMERA ANGLES            sub_62E4..6, sub_6204, sub_61C4, sub_6840, etc.
#  11.  CUTSCENE FLOW            sub_C521 / sub_CED0 / sub_4751 / sub_816B
#  12.  ENEMY ALERT HANDLER      sub_3D10  (called by trap $s:c776..c77b)
#  13.  MAIN SCRIPT              orchestrates all of the above
#
# Story-progress watermarks ($w:00000A):
#   <  9   pre-intro, force load of d01a (intro cutscene)
#   <  12  Campbell's first call after intro
#   <  16  Campbell's second / third intro calls (stages 0..2 of $w:000076)
#   <  18  intro complete; spawn the regular HUD
#   >= 18  normal gameplay
#
# Reference docs: ../../../doc/gcl/  (especially 04-commands, 07-triggers, 08-known-ids)


# ============================================================================
# 1. STAGE TRANSITIONS
# ============================================================================
# Each sub_XXXX in this section sets Snake's spawn coordinates in
# $w:800010..14 then calls `load <stage>`. The destination stage's scenerio
# reads those vars to place the player.

# sub_9FBB → load d01a (intro cutscene). Used when $w:00000A < 9 to force
# the intro to play before gameplay.
proc sub_9FBB {
    eval($f:000001 = b:0)
    load "d01a" \
        -m $s:7df9
        -s b:1
}

# sub_3DBC → load s02a (next room — north door, normal entry). Increments
# the visit counter, places Snake near the south door of s02a.
proc sub_3DBC {
    call(sub_8CD4)
    eval($f:000001 = b:0)
    eval($w:800010 = -(10000))
    eval($w:800012 = -(500))
    eval($w:800014 = 15500)
    eval($w:000002 = 2048)
    eval($w:000004 = b:3)
    load "s02a" \
        -m $s:7df9
        -s b:1
}

# sub_8CD4 — universal "stage visited" counter increment.
# Used by every transition. The "+ 1 | 128" pattern increments low 7 bits
# and sets bit 7 as a sentinel ("we've been here").
proc sub_8CD4 {
    eval($b:000000 = $b:000000 + b:1 | b:128)
}

# sub_45BC → load s02c (third visit to north door region; same spawn).
proc sub_45BC {
    call(sub_8CD4)
    eval($f:000001 = b:0)
    eval($w:800010 = -(10000))
    eval($w:800012 = -(500))
    eval($w:800014 = 15500)
    eval($w:000002 = 2048)
    eval($w:000004 = b:3)
    load "s02c" \
        -m $s:7df9
        -s b:1
}

# sub_B7E2 → load s02e (later visit, same north-door spawn).
proc sub_B7E2 {
    call(sub_8CD4)
    eval($f:000001 = b:0)
    eval($w:800010 = -(10000))
    eval($w:800012 = -(500))
    eval($w:800014 = 15500)
    eval($w:000002 = 2048)
    eval($w:000004 = b:3)
    load "s02e" \
        -m $s:7df9
        -s b:1
}

# sub_41BC → load s02b (south/east door — different spawn + different map id ede7).
proc sub_41BC {
    call(sub_8CD4)
    eval($f:000001 = b:0)
    eval($w:800010 = -(2000))
    eval($w:800012 = 7500)
    eval($w:800014 = 14500)
    eval($w:000002 = 2048)
    eval($w:000004 = b:3)
    load "s02b" \
        -m $s:ede7
        -s b:1
}

# sub_49BC → load s02d (south/east door later visit).
proc sub_49BC {
    call(sub_8CD4)
    eval($f:000001 = b:0)
    eval($w:800010 = -(2000))
    eval($w:800012 = 7500)
    eval($w:800014 = 14500)
    eval($w:000002 = 2048)
    eval($w:000004 = b:3)
    load "s02d" \
        -m $s:ede7
        -s b:1
}

# sub_D090 → load s06a (Nuke building basement). Plays an environmental SFX
# preamble. Uses absolute -p coords on the load instead of the var pre-write.
proc sub_D090 {
    sound \
        -e b:0 b:63 b:75
    eval($f:000001 = b:0)
    eval($w:000004 = b:1)
    eval($w:80001E = b:3)
    load "s06a" \
        -m $s:7df9
        -p 6464 2104 -18960
        -s b:3
}

# sub_D89E → load s12c (communication tower). Same SFX preamble pattern.
proc sub_D89E {
    sound \
        -e b:0 b:63 b:75
    eval($f:000001 = b:0)
    eval($w:000004 = b:1)
    eval($w:80001E = b:4)
    load "s12c" \
        -m $s:7df9
        -p -12636 3604 10040
        -s b:3
}


# ============================================================================
# 3. ITEM-RESPAWN GATING
# ============================================================================

# sub_3353(arg1) — decides if a pickup at slot `arg1` should respawn.
# Difficulty ($w:800002) sets the cooldown threshold ($w:000410), then the
# "elapsed visits since last pickup" is compared against it. Result goes
# into $f:040001 (1 = spawn the item, 0 = skip).
#
#   $w:800002 = -1 / 0  (Easy)    → cooldown 3 visits
#   $w:800002 = 1       (Normal)  → cooldown 5
#   $w:800002 = 2       (Hard)    → cooldown 7
#   $w:800002 = 3       (Extreme) → never respawn (cooldown 9999, hard-disabled below)
#
# arg1 < 128 means "never picked up" (high bit = visited sentinel from sub_8CD4).
proc sub_3353 {
    if ($w:800002 < b:0) {
        eval($w:000410 = b:3)
    } elseif ($w:800002 == b:0) {
        eval($w:000410 = b:3)
    } elseif ($w:800002 == b:1) {
        eval($w:000410 = b:5)
    } elseif ($w:800002 == b:2) {
        eval($w:000410 = b:7)
    } else {
        eval($w:000410 = 9999)
    }
    if (arg1 < b:128) {
        # Never collected → always spawn.
        eval($f:040001 = b:1)
    } elseif ($w:800002 == b:3) {
        # Extreme mode: collected items never come back.
        eval($f:040001 = b:0)
    } elseif (($b:000000 - arg1 + b:128 & b:127) >= $w:000410) {
        # Enough visits have elapsed since pickup — spawn.
        eval($f:040001 = b:1)
    } else {
        eval($f:040001 = b:0)
    }
}


