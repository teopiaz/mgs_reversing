# ============================================================================
# 11. CUTSCENE FLOW  (intro → Liquid → Meryl reveal)
# ============================================================================

# sub_816B — "cutscene segment finished, return to gameplay".
# Resets phase counters, re-enables menu+pad, restores ambience, and rebuilds
# the HUD (sub_1907/1909). End of $b:000074 = 3 → 4 transition.
proc sub_816B {
    eval($f:05006E = b:0)
    eval($b:000074 = b:0)
    menu \
        -r 1
        -m 1
        -l 1
    pad \
        -s
    sound \
        -b b:1 b:2
        -n
    mesg $s:c356 4 $s:d5cc
    mesg $s:24de $s:0dd2
    mesg $s:6eca $s:d420
    if ($w:80006C >= b:1) {
        call(sub_1909)
    } else {
        call(sub_1907)
    }
}

# sub_A87E — cutscene branch A handler (when timer expires choice 1).
# Parks Snake at fixed spawn, sets cutscene replay slot to 1, fades + restarts.
proc sub_A87E {
    menu \
        -r 0
        -m 0
        -l 0
    pad \
        -r
    mesg $s:24de $s:d5cc
    eval($b:000074 = b:0)
    eval($b:000075 = b:1)         # replay slot 1 = "branch A"
    eval($f:05006E = b:1)
    eval($w:800010 = -(2136))
    eval($w:800012 = 2104)
    eval($w:800014 = -(5960))
    eval($w:000004 = b:1)
    chara $s:a12e $s:62fe \
        -m 0
        -s 30
    delay \
        -t 32
        -e {
        restart
    }
}

# sub_AC00 — cutscene branch B (replay slot 2).
proc sub_AC00 {
    menu \
        -r 0
        -m 0
        -l 0
    pad \
        -r
    mesg $s:24de $s:d5cc
    eval($b:000074 = b:0)
    eval($b:000075 = b:2)
    eval($f:05006E = b:1)
    eval($w:800010 = -(2136))
    eval($w:800012 = 2104)
    eval($w:800014 = -(5960))
    eval($w:000004 = b:1)
    chara $s:a12e $s:62fe \
        -m 0
        -s 30
    delay \
        -t 32
        -e {
        restart
    }
}

