    eval($b:000074 = b:3)
    delay \
        -t 15
        -p sub_D090
}

# sub_1C26 — schedule transition to s12c after 15 frames.
proc sub_1C26 {
    eval($f:05006E = b:1)
    eval($b:000074 = b:3)
    delay \
        -t 15
        -p sub_D89E
}

# sub_C521 — cutscene step 1: "Snake meets Demodoll dialogue". Spawns the
# demo doll (CHARAID_DEMODOLL = $s:e97e) with one of three motion variants
# selected by the replay slot ($b:000075). Plays scripted camera + msgs.
proc sub_C521 {
    chara $s:a12e $s:62fe \
        -m 1
        -s 15
    if ($b:000075 == b:0) {
        chara $s:e97e $s:fec0 \
            -s t:00002A53 t:00002A5F
            -o $s:3469
            -w $s:4725
            -m $s:96b6
            -x 1 1 2 1 13 3
            -r b:19
            -e sub_3B72
    } elseif ($b:000075 == b:1) {
        chara $s:e97e $s:fec0 \
            -s t:00002A53 t:00002A70
            -o $s:3469
            -w $s:4725
            -m $s:96b6
            -x 1 1 2 1 13 3
            -r b:19
            -e sub_3B72
    } else {
        chara $s:e97e $s:fec0 \
            -s t:00002A53 t:00002A7E
            -o $s:3469
            -w $s:4725
            -m $s:96b6
            -x 1 1 2 1 13 3
            -r b:19
            -e sub_3B72
    }
    mesg $s:fec0 0
    camera \
        -s b:4 b:1 b:0 b:0 -1802 2850 -8403 -2752 1414 -6458
    mesg $s:c356 4 $s:0dd2
}

# sub_CED0 — cutscene step 2: explosion. Pre-rumbles the controller via
# PADVIBRATE ($s:fed1), spawns blink overlays, plays main rumble after 40f.
proc sub_CED0 {
    chara $s:a12e $s:62fe \
        -m 1
        -s 15
    camera \
        -s b:4 b:1 b:0 b:0 1114 4937 -13934 -4003 5 -7083
    mesg $s:c356 4 $s:0dd2
    sound \
        -v t:00002A8E
        -f sub_D4FD
    delay \
        -t 120
        -e {
        chara $s:fed1 $s:922b b:127 b:2 b:0 b:8 b:127 b:2
        chara $s:fed1 $s:a83b b:115 b:4 b:55 b:6 b:120 b:4 b:85 b:4 b:60 b:8 b:45 b:8
    }
    delay \
        -t 40
        -e {
        chara $s:8185 $s:a3ab \
            -t $s:aef2
            -s 800 800 1600 1600
            -p -3500 1500 -11100 -1500 1500 -11100
            -n b:1
    }
}

# sub_4751 — cutscene step 3: "next branch" — calls sub_CB61 (s06a) or
# sub_1C26 (s12c) depending on which replay slot.
proc sub_4751 {
    chara $s:a12e $s:62fe \
        -m 1
        -s 15
    camera \
        -s b:4 b:1 b:0 b:0 -3500 2565 -5503 -1433 1094 -6666
    mesg $s:c356 4 $s:0dd2
    delay \
        -t 60
        -e {
        eval($f:05006E = b:0)
        if ($b:000075 == b:1) {
            call(sub_CB61)
        } else {
            call(sub_1C26)
        }
    }
}

# sub_EAB1 — end-of-intro callback fired by the demosel chara. arg1=1 means
# user pressed "skip"; otherwise restore camera angles and shadows.
proc sub_EAB1 {
    if ($f:030435 == b:1) {
        mesg $s:c356 5 $s:d5cc
    }
    eval($w:80001C = $w:000072)
    if (arg1 == b:1) {
        eval($w:80001E = -(b:1))
        restart
    } else {
        mesg $s:6eca $s:d420
        if ($f:030435 == b:1) {
            # Re-position the three kage actors at their alert spots.
            mesg $s:1465 $s:430f 21 -9000 0 3000
            mesg $s:1466 $s:430f 22 0 30000 0
            mesg $s:1467 $s:430f 23 -1500 6000 -17000
        }
    }
}


