proc sub_200D {
    light \
        -d 50 -90 -100
    light \
        -c 64 64 96
    light \
        -a 24 32 46
}


# ============================================================================
# 5. CODEC LOW-HP NAGS
# ============================================================================

# sub_CCE3 — recursive HP-watch loop. Re-arms itself every 30 frames via
# `delay -t 30 -e { call(sub_CCE3) }`. Triggers Deepthroat / Campbell calls
# at HP thresholds (HP percent in $w:80006E):
#
#   60 < HP <= 20   → Deepthroat (14048) calls once ($f:050001 latched)
#    0 < HP <= 20   → Campbell  (14085) calls once  ($f:060001 latched)
#   HP <  0         → "Snake's down" call after a 170-frame delay,
#                     then waits 60 more frames and triggers game-over.
#
# $f:0300F8 is "codec disabled" — when set, suppress new calls (e.g. boss).
# $w:0003EA is the "dead countdown" 0..60.
proc sub_CCE3 {
    if (b:20 < $w:80006E && $w:80006E <= b:60 && !($f:050001)) {
        if (!($f:0300F8)) {
            radio \
                -c 14048 t:01010855 b:0
            eval($f:050001 = b:1)
        }
        delay \
            -t 30
            -e {
            call(sub_CCE3)
        }
    } elseif (b:0 < $w:80006E && $w:80006E <= b:20 && !($f:060001)) {
        if (!($f:0300F8)) {
            radio \
                -c 14085 t:01010366 b:0
            eval($f:060001 = b:1)
        }
        delay \
            -t 30
            -e {
            call(sub_CCE3)
        }
    } elseif ($w:80006E < b:0 && !($f:070001)) {
        # First frame Snake "died" — schedule the codec death-call.
        eval($f:0703E5 = b:1)
        delay \
            -t 170
            -e {
            eval($f:070001 = b:1)
            radio \
                -c 14085 t:01010177 b:0
            delay \
                -t 30
                -e {
                call(sub_CCE3)
            }
        }
    } elseif ($w:80006E < b:0 && $w:0003EA < b:60) {
        # Death countdown ticking up.
        eval($w:0003EA = $w:0003EA + b:1)
        delay \
            -t 30
            -e {
            call(sub_CCE3)
        }
    } elseif ($w:0003EA == b:60) {
        # Countdown finished — flag game-over and stop polling.
        eval($f:0003E8 = b:1)
        eval($w:0003EA = b:255)
    } else {
        delay \
            -t 30
            -e {
            call(sub_CCE3)
        }
    }
}


# ============================================================================
# CAMERA-MODE STATE MACHINE (extra cameras / radar mode)
# ============================================================================

# sub_1C8A — camera-mode transition tracker. Watches $w:800082 (radar mode)
# and computes which transition just happened ($b:00000C → $b:00000D).
# Self-reschedules every 30 frames via `delay -p sub_1C8A`.
#
#   $b:00000C is the previous radar mode (0/1/2)
#   $b:00000D is the most-recent transition id (1..6)
#
# Used by the HUD/radar to play the right "switching radar mode" SFX.
proc sub_1C8A {
    if ($w:800082 == b:0) {
        if ($b:00000C == b:1) {
            eval($b:00000D = b:1)
        } elseif ($b:00000C == b:2) {
            eval($b:00000D = b:2)
        }
        eval($b:00000C = b:0)
    } elseif ($w:800082 == b:2) {
        if ($b:00000C == b:0) {
            eval($b:00000D = b:3)
        } elseif ($b:00000C == b:1) {
            eval($b:00000D = b:4)
        }
        eval($b:00000C = b:2)
    } elseif ($w:800082 == b:1) {
        if ($b:00000C == b:0) {
            eval($b:00000D = b:5)
        } elseif ($b:00000C == b:2) {
            eval($b:00000D = b:6)
        }
        eval($b:00000C = b:1)
    }
    delay \
        -t 30
        -p sub_1C8A
}


# ============================================================================
# 6. SAVE-MEMO MANAGEMENT  (codec contacts that nag you to save)
# ============================================================================

# sub_E42A — Nastasha (14152) save reminders. Picks one of 8 dialogue lines
# based on story progress ($w:00000A), so she says progressively more urgent
# / variant lines as the game advances.
proc sub_E42A {
    if ($w:00000A < b:24) {
        radio \
            -b 14152 t:0E0A057F
    } elseif (b:24 <= $w:00000A && $w:00000A < b:50) {
        radio \
            -b 14152 t:17140597
    } elseif (b:50 <= $w:00000A && $w:00000A < b:111) {
        radio \
            -b 14152 t:181505C2
    } elseif (b:111 <= $w:00000A && $w:00000A < b:137) {
        radio \
            -b 14152 t:1A1805EF
    } elseif (b:137 <= $w:00000A && $w:00000A < b:160) {
        radio \
            -b 14152 t:16140621
    } elseif (b:160 <= $w:00000A && $w:00000A < b:188) {
        radio \
            -b 14152 t:1B18064B
    } elseif (b:188 <= $w:00000A && $w:00000A < b:237) {
        radio \
            -b 14152 t:1816067E
    } elseif (b:237 <= $w:00000A) {
        radio \
            -b 14152 t:1B1906AC
    } else {}
}

# sub_860B — clear codec memos for contacts whose call counters are 0.
# Each `radio -m <contact> "clear"` removes the "saved memo" indicator.
# Called once on stage entry to scrub stale UI.
proc sub_860B {
    if ($w:00000E <= b:0) {
        radio \
            -m 14180 "clear"
    }
    if ($w:000010 <= b:0) {
        radio \
            -m 14152 "clear"
    }
    if ($w:000012 <= b:0) {
        radio \
            -m 14112 "clear"
    }
    if (!($f:05023D)) {
        radio \
            -m 14048 "clear"
    }
    if ($w:0001F0 <= b:0) {
        radio \
            -m 14015 "clear"
    }
    if ($w:000462 <= b:0) {
        radio \
            -m 14007 "clear"
    }
}

# sub_8132 — Master (14007) save call. Used as a callback by sub_DB13.
proc sub_8132 {
    if ($f:0403F8) {
        radio \
            -a
        radio \
            -b 14007 t:24241506
    }
}

# sub_5A77 — Campbell (14085) save reminder. Two variants based on progress.
proc sub_5A77 {
    if ($w:00000A < b:137) {
        radio \
            -b 14085 t:19160387
    } elseif (b:137 <= $w:00000A) {
        radio \
            -b 14085 t:171303B6
    }
}

# sub_DB13 — Mei Ling (14096) save reminder. After a certain progress point
# she also chains into a Master call (sub_8132).
proc sub_DB13 {
    if ($w:00000A < b:153) {
        radio \
            -b 14096 t:171700CC
    } elseif (b:153 <= $w:00000A && $w:00000A < 279) {
        radio \
            -b 14096 t:141500FA
    } else {
        radio \
            -b 14096 t:141500FA
            -p sub_8132
    }
}


# ============================================================================
# 7. SAVE JINGLE PICKER
# ============================================================================

# sub_49C9 — picks the "save complete" SFX based on $w:0002CA (the save
# success code emitted by the menu). Each branch resets the counter then
# plays a unique short tune. Branches 8/10..275/etc. fall through to
# random tunes via `rand 9` / `rand 12`. $w:0002C2 holds the rand result.
#
# (Trivia: this is the source of the famous MGS "save successful" jingle.)
proc sub_49C9 {
    if ($w:0002CA == b:1) {
        eval($w:0002CA = b:0)
        varsave $w:0002CA
        sound \
            -g t:000173B3
    } elseif ($w:0002CA == b:2) {
        eval($w:0002CA = b:0)
        varsave $w:0002CA
        sound \
            -g t:00016DD2
    } elseif ($w:0002CA == b:3) {
        eval($w:0002CA = b:0)
        varsave $w:0002CA
        sound \
            -g t:000172D4
    } elseif ($w:0002CA == b:4) {
        eval($w:0002CA = b:0)
        varsave $w:0002CA
        sound \
            -g t:00016DD2
    } elseif ($w:0002CA == b:5) {
        eval($w:0002CA = b:0)
        varsave $w:0002CA
        sound \
            -g t:00017410
    } elseif ($w:0002CA == b:6) {
        eval($w:0002CA = b:0)
        varsave $w:0002CA
        sound \
            -g t:00016DD2
    } elseif ($w:0002CA == b:7) {
        eval($w:0002CA = b:0)
        varsave $w:0002CA
        sound \
            -g t:0001734A
    } elseif ($w:0002CA == b:9) {
        eval($w:0002CA = b:0)
        varsave $w:0002CA
        sound \
            -g t:000174E6
    } elseif ($w:80001A & b:8 && $w:00000A < b:237) {
        # Special-state save (combat?) — different tune + reset alert flags.
        eval($w:80001A = b:0)
        eval($f:060001 = b:0)
        varsave $f:060001
        sound \
            -g t:00017547
    } elseif (b:246 <= $w:00000A && $w:00000A < 275) {
        # Late-game: pick from 9 random "endgame" tunes.
        rand 9
        if ($w:0002C2 % b:9 == b:0) {
            sound \
                -g t:00016D04
        } elseif ($w:0002C2 % b:9 == b:1) {
            sound \
                -g t:00016D6D
        } elseif ($w:0002C2 % b:9 == b:2) {
            sound \
                -g t:00016DD2
        } elseif ($w:0002C2 % b:9 == b:3) {
            sound \
                -g t:00016E37
        } elseif ($w:0002C2 % b:9 == b:4) {
            sound \
                -g t:00016E9C
        } elseif ($w:0002C2 % b:9 == b:5) {
            sound \
                -g t:00017058
        } elseif ($w:0002C2 % b:9 == b:6) {
            sound \
                -g t:000170C1
        } elseif ($w:0002C2 % b:9 == b:7) {
            sound \
                -g t:00017136
        } else {
            sound \
                -g t:0001719F
        }
    } elseif (275 <= $w:00000A && $w:00000A < 285) {
        # Very-late-game: 3 finale tunes.
        rand 3
        if ($w:0002C2 % b:3 == b:1) {
            sound \
                -g t:000170C1
        } elseif ($w:0002C2 % b:3 == b:2) {
            sound \
                -g t:00017136
        } else {
            sound \
                -g t:0001719F
        }
    } else {
        # Normal mid-game: 12 tunes randomised on visit count.
        rand 12
        eval($w:0002C2 = $w:80000A)
        if ($w:0002C2 % b:12 == b:0) {
            sound \
                -g t:00016D04
        } elseif ($w:0002C2 % b:12 == b:1) {
            sound \
                -g t:00016D6D
        } elseif ($w:0002C2 % b:12 == b:2) {
            sound \
                -g t:00016DD2
        } elseif ($w:0002C2 % b:12 == b:3) {
            sound \
                -g t:00016E37
        } elseif ($w:0002C2 % b:12 == b:4) {
            sound \
                -g t:00016E9C
        } elseif ($w:0002C2 % b:12 == b:5) {
            sound \
                -g t:00016F01
        } elseif ($w:0002C2 % b:12 == b:6) {
            sound \
                -g t:00016F7A
        } elseif ($w:0002C2 % b:12 == b:7) {
            sound \
                -g t:00016FEF
        } elseif ($w:0002C2 % b:12 == b:8) {
            sound \
                -g t:00017058
        } elseif ($w:0002C2 % b:12 == b:9) {
            sound \
                -g t:000170C1
        } elseif ($w:0002C2 % b:12 == b:10) {
            sound \
                -g t:00017136
        } else {
            sound \
                -g t:0001719F
        }
    }
}


# ============================================================================
# Helpers / callbacks
# ============================================================================

# sub_AD2D — bare restart, used as a callback param to `radio -p sub_AD2D`
# so a codec call hangup auto-restarts the stage (forces re-init).
proc sub_AD2D {
    restart
}

# sub_2631 — empty placeholder. Referenced by the timer chara (CHARAID_TIMER)
# as the "no-op" callback slot. Replaced by sub_A87E / sub_AC00 for the
# real continue-prompt branches.
proc sub_2631 {}

# sub_8892 — alert state-machine handler (registered as system -a callback).
# arg1 is the new alert phase:
#   0 = clear, 1 = caution, 2 = ALERT
# On entry to ALERT phase, repositions kage(1465) to the alert spawn point
# and triggers the alarm sound chain via sub_1055.
proc sub_8892 {
    eval($b:00006F = arg1)
    if (arg1 == b:2) {
        if ($f:03006E == b:0) {
            eval($f:03006E = b:1)
            mesg $s:1465 $s:430f 16 -9500 0 -12250
        }
        if ($f:04006E == b:1) {
            call(sub_1055)
        }
    }
}

# sub_1055 — "alert ended" cleanup: end alarm SFX, clear $f:04006E, send
# leave-event to the cinema chara (CHARAID_CINEMA).
proc sub_1055 {
    sound \
        -x sd:FFFFFFFD
    eval($f:04006E = b:0)
    mesg $s:6eca $s:745d
}


# ============================================================================
# 8. HUD / CAMERA COMMANDER  (the security cam + searchlights + doors actor)
# ============================================================================
#
# sub_1907 / sub_1908 / sub_1909 are three variants of the same setup
# differing only in vibration intensity ($w:000412..) or the second proc in
# the -n list. The COMMANDER chara (CHARAID_COMMANDER = $s:c6d7) glues
# everything together via callback procs:
#
#   -n sub_7ECB sub_7ECC sub_7ECD     three "watcher" guards
#   -s sub_A22F sub_A230               two searchlights
#   -c sub_8B69 sub_8B6A sub_8B6B sub_8B6C  four security cameras
#   -v ...                              alert volume zones
#   -l ...                              detection radii (per difficulty)
#   -y ...                              alert grace timer

# sub_1907 — default commander setup (uses difficulty-tuned alert params).
proc sub_1907 {
    chara $s:c6d7 $s:23ef \
        -n sub_7ECB sub_7ECC sub_7ECD
        -s sub_A22F sub_A230
        -c sub_8B69 sub_8B6A sub_8B6B sub_8B6C
        -v -6500 0 19000 14000 1500 12000 -3000 0 -12000
        -f b:0
        -t b:1
        -l $w:000412 $w:000414 $w:000416
        -y $w:000418
    delay \
        -t 3
        -e {
        mesg $s:dd6d $s:ed7f
    }
}

# sub_7ECB — sets up watcher 1 (kage1), the patrolling guard near the south
# door. Two variants depending on $w:80006C (replay-aware re-entry).
proc sub_7ECB {
    map \
        -a $s:7df9
    if ($w:80006C >= b:1) {
        chara $s:6e9a $s:1465 \
            -r b:16
            -b 'P'
            -a 'S'
            -f 7
            -l 192
            -n -9500 0 -12250
            -y b:1
            -t sd:0000000F sd:0000001E sd:0000005A sd:00000708
    } else {
        chara $s:6e9a $s:1465 \
            -r b:15
            -b 'P'
            -a 'S'
            -f 7
            -l 192
            -n -9500 0 -12000
            -y b:1
            -t sd:0000000F sd:0000001E sd:0000005A sd:00000708
    }
}

# sub_7ECC — watcher 2 (kage2), parked at (0, 30000, 0) — basically off-stage.
