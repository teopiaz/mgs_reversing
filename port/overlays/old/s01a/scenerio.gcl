# Only fires once per visit (gated by $f:06006E latch).
# arg1 selects one of 6 known spotting positions (around the room).
proc sub_3D10 {
    if ($f:06006E != b:1) {
        eval($f:06006E = b:1)
        if ($b:00006F == b:0) {
            eval($f:04006E = b:1)
            sound \
                -v t:00017213
            chara $s:7a05 $s:6eca \
                -t 30000
                -e 0
            if (arg1 == b:0) {
