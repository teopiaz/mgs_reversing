# s99z collision mesh.
#
# Mirrors the visual mesh's floor + walls and adds two `trap_*` cubes
# and one `cam_*` cube to exercise Wave 2's HZD authoring pipeline.
#
# Object naming convention (see port/doc/editor/05-stage-authoring.md):
#   wall_*       → HZD_SEG (collision wall, blocks Snake)
#   trap_<name>  → HZD_TRP (trigger volume; bind in scenerio.gcl)
#   cam_<name>   → HZD_CAM (behind-mode camera zone)
#   anything else → HZD_FLR (walkable floor)

# --- shared corners ----------------------------------------------------
v -50  0 -50
v  50  0 -50
v  50  0  50
v -50  0  50
v -50 30 -50
v  50 30 -50
v  50 30  50
v -50 30  50

vt 0 0

s 0
o floor_main
f 1/1 2/1 3/1 4/1

o wall_south
f 1/1 5/1 6/1 2/1
o wall_east
f 2/1 6/1 7/1 3/1
o wall_north
f 3/1 7/1 8/1 4/1
o wall_west
f 4/1 8/1 5/1 1/1

# --- trap_alarm: 10×10×30 cube near the centre. Fires on enter. -----
v -5  0 -5
v  5  0 -5
v  5  0  5
v -5  0  5
v -5 30 -5
v  5 30 -5
v  5 30  5
v -5 30  5

o trap_alarm
f 9/1 10/1 11/1 12/1
f 13/1 14/1 15/1 16/1
f 9/1 13/1 14/1 10/1
f 10/1 14/1 15/1 11/1
f 11/1 15/1 16/1 12/1
f 12/1 16/1 13/1  9/1

# --- trap_door: tall slab at the south wall, near doorway position. -
v -10  0 -50
v  10  0 -50
v  10  0 -40
v -10  0 -40
v -10 30 -50
v  10 30 -50
v  10 30 -40
v -10 30 -40

o trap_door
f 17/1 18/1 19/1 20/1
f 21/1 22/1 23/1 24/1
f 17/1 21/1 22/1 18/1
f 18/1 22/1 23/1 19/1
f 19/1 23/1 24/1 20/1
f 20/1 24/1 21/1 17/1

# --- cam_main: covers the whole room. Editor renders it as a camera. -
v -45  0 -45
v  45  0 -45
v  45  0  45
v -45  0  45
v -45 25 -45
v  45 25 -45
v  45 25  45
v -45 25  45

o cam_main
f 25/1 26/1 27/1 28/1
f 29/1 30/1 31/1 32/1
f 25/1 29/1 30/1 26/1
f 26/1 30/1 31/1 27/1
f 27/1 31/1 32/1 28/1
f 28/1 32/1 29/1 25/1
