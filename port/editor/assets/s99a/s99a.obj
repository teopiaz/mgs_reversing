# Open courtyard for s99a — outdoor plaza with perimeter wall, gate
# opening on the south side, and an interior bunker in the NW quadrant.
#
# OBJ units → PSX world units via import_stage.py --scale 100, so the
# numbers below are 1/100th of the in-engine coordinates. Empirically
# the editor renders +Y as "up": walls extend into POSITIVE Y to stand
# above the ground plane. (The ed_camera.c header comments claim "+Y
# is down" but the visible result contradicts them.)
#
# Layout (top-down, +X right, +Z south):
#
#     X=-100        X=0         X=+100
# Z=-100  +----------------------+
#         | bunker               |
#         | (-60..-20,-60..-20)  |
#         | door faces +Z        |
#         |                      |
#         |                      |
# Z=+100  +------- gate ---------+   gate gap: X=-15..+15
#
# All quads share UVs (0,0)-(1,0)-(1,1)-(0,1). Ground is split into a
# 4x4 grid so the texture tiles 4 times across each axis (kmd_writer
# clamps UVs to [0,1], so tiling has to come from geometry subdivision).

mtllib s99a.mtl

o courtyard

# === A. Ground tile grid: 5x5 verts at Y=0 ============================
# Vertex at column i (0..4, X=-100+50*i) and row j (0..4, Z=-100+50*j)
# is OBJ index  1 + i + j*5.
v -100 0 -100
v  -50 0 -100
v    0 0 -100
v   50 0 -100
v  100 0 -100
v -100 0  -50
v  -50 0  -50
v    0 0  -50
v   50 0  -50
v  100 0  -50
v -100 0    0
v  -50 0    0
v    0 0    0
v   50 0    0
v  100 0    0
v -100 0   50
v  -50 0   50
v    0 0   50
v   50 0   50
v  100 0   50
v -100 0  100
v  -50 0  100
v    0 0  100
v   50 0  100
v  100 0  100

# === B. North perimeter wall (Z=-100, full width) =====================
v -100  0 -100
v  100  0 -100
v  100 30 -100
v -100 30 -100

# === C. South perimeter wall, left of gate (X=-100..-15) ==============
v -100  0 100
v  -15  0 100
v  -15 30 100
v -100 30 100

# === D. South perimeter wall, right of gate (X=+15..+100) =============
v  15  0 100
v 100  0 100
v 100 30 100
v  15 30 100

# === E. East perimeter wall (X=+100) ==================================
v 100  0 -100
v 100  0  100
v 100 30  100
v 100 30 -100

# === F. West perimeter wall (X=-100) ==================================
v -100  0 -100
v -100  0  100
v -100 30  100
v -100 30 -100

# === G. Bunker (X=-60..-20, Z=-60..-20, height +20 = up) ==============
# G1 north face (Z=-60)
v -60  0 -60
v -20  0 -60
v -20 20 -60
v -60 20 -60
# G2 east face (X=-20)
v -20  0 -60
v -20  0 -20
v -20 20 -20
v -20 20 -60
# G3 west face (X=-60)
v -60  0 -60
v -60  0 -20
v -60 20 -20
v -60 20 -60
# G4 south face left of doorway (X=-60..-46, Z=-20)
v -60  0 -20
v -46  0 -20
v -46 20 -20
v -60 20 -20
# G5 south face right of doorway (X=-34..-20, Z=-20)
v -34  0 -20
v -20  0 -20
v -20 20 -20
v -34 20 -20
# G6 doorway lintel (X=-46..-34, Y=14..20)
v -46 14 -20
v -34 14 -20
v -34 20 -20
v -46 20 -20
# G7 roof (Y=20)
v -60 20 -60
v -20 20 -60
v -20 20 -20
v -60 20 -20

# === H. Closed door across the bunker doorway =========================
# Single panel quad filling the doorway opening on the bunker's south
# face (X=-46..-34, Y=0..14, Z=-20). Sits in the same plane as the
# lintel above it; together they seal the doorway visually.
v -46  0 -20
v -34  0 -20
v -34 14 -20
v -46 14 -20

# Four UVs cover every quad's full 0..1 texture range.
vt 0 0
vt 1 0
vt 1 1
vt 0 1

usemtl s99a_ground

# Ground tiles (4x4 = 16 quads). Each tile (ti, tj) for ti,tj in 0..3
# uses the four corners at grid (ti,tj), (ti+1,tj), (ti+1,tj+1), (ti,tj+1)
# with UVs (0,0), (1,0), (1,1), (0,1).
f 1/1 2/2 7/3 6/4
f 2/1 3/2 8/3 7/4
f 3/1 4/2 9/3 8/4
f 4/1 5/2 10/3 9/4
f 6/1 7/2 12/3 11/4
f 7/1 8/2 13/3 12/4
f 8/1 9/2 14/3 13/4
f 9/1 10/2 15/3 14/4
f 11/1 12/2 17/3 16/4
f 12/1 13/2 18/3 17/4
f 13/1 14/2 19/3 18/4
f 14/1 15/2 20/3 19/4
f 16/1 17/2 22/3 21/4
f 17/1 18/2 23/3 22/4
f 18/1 19/2 24/3 23/4
f 19/1 20/2 25/3 24/4

usemtl s99a_wall

# Perimeter walls
f 26/1 27/2 28/3 29/4
f 30/1 31/2 32/3 33/4
f 34/1 35/2 36/3 37/4
f 38/1 39/2 40/3 41/4
f 42/1 43/2 44/3 45/4

# Bunker walls + roof
f 46/1 47/2 48/3 49/4
f 50/1 51/2 52/3 53/4
f 54/1 55/2 56/3 57/4
f 58/1 59/2 60/3 61/4
f 62/1 63/2 64/3 65/4
f 66/1 67/2 68/3 69/4
f 70/1 71/2 72/3 73/4

# Closed door panel
f 74/1 75/2 76/3 77/4
